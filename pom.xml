    <properties>
        <targetJdk>21</targetJdk>
        <maven.compiler.release>21</maven.compiler.release>
        <componentName>platform</componentName>
    </properties>

    <scm>
        <connection>scm:git:https://github.com/lutece-platform/lutece-ai-plugin-platform.git</connection>
        <developerConnection>scm:git:https://github.com/lutece-platform/lutece-ai-plugin-platform.git</developerConnection>
        <url>https://github.com/lutece-platform/lutece-ai-plugin-platform.git</url>
        <tag>HEAD</tag>
    </scm>

</project>
