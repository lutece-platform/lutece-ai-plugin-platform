  KEY `idx_doc_intelligence` (`use_document_intelligence`,`document_intelligence_provider_id`),
  KEY `fk_dataset_document_di_provider` (`document_intelligence_provider_id`),
  KEY `idx_document_weight` (`weight`),
  CONSTRAINT `fk_dataset_document_di_provider` FOREIGN KEY (`document_intelligence_provider_id`) REFERENCES `platform_provider` (`provider_id`) ON DELETE SET NULL,
  CONSTRAINT `fk_document_dataset` FOREIGN KEY (`dataset_id`) REFERENCES `platform_dataset` (`dataset_id`) ON DELETE CASCADE,
  CONSTRAINT `chk_document_weight` CHECK (`weight` >= 0.1 and `weight` <= 10.0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_pipeline_user_rate_limit` (
