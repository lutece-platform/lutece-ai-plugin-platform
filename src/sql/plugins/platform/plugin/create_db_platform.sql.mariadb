  `target_node_id` int(11) NOT NULL,
  `label` varchar(500) DEFAULT NULL,
  `sort_order` int(11) NOT NULL DEFAULT 0,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id_decision_transition`),
  KEY `fk_transition_source` (`source_node_id`),
  KEY `fk_transition_target` (`target_node_id`),
  CONSTRAINT `fk_transition_source` FOREIGN KEY (`source_node_id`) REFERENCES `platform_decision_node` (`id_decision_node`) ON DELETE CASCADE,
  CONSTRAINT `fk_transition_target` FOREIGN KEY (`target_node_id`) REFERENCES `platform_decision_node` (`id_decision_node`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_unicode_ci;

