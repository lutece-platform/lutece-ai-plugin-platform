  CONSTRAINT `fk_dataset_client` FOREIGN KEY (`client_id`) REFERENCES `platform_client` (`id`) ON DELETE CASCADE,
  CONSTRAINT `fk_dataset_embed_provider` FOREIGN KEY (`embed_provider_id`) REFERENCES `platform_provider` (`provider_id`),
  CONSTRAINT `fk_dataset_llm_provider` FOREIGN KEY (`llm_provider_id`) REFERENCES `platform_provider` (`provider_id`),
  CONSTRAINT `chk_dataset_weight` CHECK (`weight` >= 0.1 and `weight` <= 10.0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

