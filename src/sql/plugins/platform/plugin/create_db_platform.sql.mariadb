) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_unicode_ci;

CREATE TABLE `platform_decision_transition` (
  `id_decision_transition` int(11) NOT NULL AUTO_INCREMENT,
