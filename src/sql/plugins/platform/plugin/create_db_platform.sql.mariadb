  KEY `idx_node_execution_id` (`execution_id`),
  KEY `idx_node_execution_node` (`node_id`),
  KEY `idx_node_execution_order` (`execution_id`,`execution_order`),
  KEY `idx_node_execution_start_time` (`start_time`),
  CONSTRAINT `fk_node_execution` FOREIGN KEY (`execution_id`) REFERENCES `platform_observability_resource_execution` (`execution_id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_client` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `name` varchar(255) NOT NULL,
  `code` varchar(255) NOT NULL,
  `description` mediumtext DEFAULT NULL,
  `active` tinyint(1) DEFAULT 1,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_client_code` (`code`),
  KEY `idx_client_active` (`active`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_conversation_message_feedback` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `message_id` int(11) NOT NULL,
  `user_id` varchar(255) NOT NULL,
  `bot_id` int(11) NOT NULL,
  `client_id` int(11) NOT NULL DEFAULT 0,
  `is_positive` tinyint(1) NOT NULL,
  `comment` text DEFAULT NULL,
  `status` varchar(50) NOT NULL DEFAULT 'pending',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_feedback_message` (`message_id`),
  KEY `idx_feedback_message` (`message_id`),
  KEY `idx_feedback_user` (`user_id`),
  KEY `idx_feedback_bot` (`bot_id`),
  KEY `idx_feedback_client` (`client_id`),
  KEY `idx_feedback_status` (`status`),
  KEY `idx_feedback_positive` (`is_positive`),
  KEY `idx_feedback_created` (`created_at`),
  KEY `idx_feedback_bot_status` (`bot_id`,`status`),
  CONSTRAINT `fk_feedback_bot` FOREIGN KEY (`bot_id`) REFERENCES `platform_bot` (`bot_id`) ON DELETE CASCADE,
  CONSTRAINT `fk_feedback_message` FOREIGN KEY (`message_id`) REFERENCES `platform_conversation_message` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_bot_user_rate_limit` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `user_id` varchar(255) NOT NULL,
  `bot_id` int(11) NOT NULL,
  `message_count` int(11) NOT NULL DEFAULT 0,
  `date_first_message` timestamp NOT NULL DEFAULT current_timestamp(),
  `date_last_message` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_user_bot_date` (`user_id`,`bot_id`,`date_first_message`),
  KEY `idx_rate_limit_bot` (`bot_id`),
  KEY `idx_rate_limit_date` (`date_first_message`),
  CONSTRAINT `fk_rate_limit_bot` FOREIGN KEY (`bot_id`) REFERENCES `platform_bot` (`bot_id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_vision` (
  `vision_id` int(11) NOT NULL AUTO_INCREMENT,
  `vision_title` varchar(255) NOT NULL,
  `vision_description` mediumtext DEFAULT NULL,
  `provider_id` int(11) NOT NULL,
  `client_id` int(11) NOT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`vision_id`),
  KEY `idx_vision_provider` (`provider_id`),
  KEY `idx_vision_client` (`client_id`),
  KEY `idx_vision_title_client` (`vision_title`,`client_id`),
  CONSTRAINT `fk_vision_client` FOREIGN KEY (`client_id`) REFERENCES `platform_client` (`id`) ON DELETE CASCADE,
  CONSTRAINT `fk_vision_provider` FOREIGN KEY (`provider_id`) REFERENCES `platform_provider` (`provider_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_decision_tree_image` (
  `content_hash` varchar(64) NOT NULL,
  `tree_id` int(11) NOT NULL,
  `file_store_key` varchar(255) NOT NULL,
  `mime_type` varchar(100) NOT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`content_hash`,`tree_id`),
  KEY `idx_decision_tree_image_tree` (`tree_id`),
  CONSTRAINT `fk_decision_tree_image_tree` FOREIGN KEY (`tree_id`) REFERENCES `platform_decision_tree` (`id_decision_tree`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_observability_resource_node_trace` (
  `id_trace` int(11) NOT NULL AUTO_INCREMENT,
  `id_node_execution` int(11) NOT NULL,
  `message` mediumtext DEFAULT NULL,
  `data` mediumtext DEFAULT NULL,
  `timestamp` timestamp NOT NULL DEFAULT current_timestamp(),
  `status` varchar(50) DEFAULT NULL,
  `cost` decimal(10,8) DEFAULT NULL,
  PRIMARY KEY (`id_trace`),
  KEY `idx_trace_node_execution` (`id_node_execution`),
  KEY `idx_trace_timestamp` (`timestamp`),
  KEY `idx_trace_status` (`status`),
  CONSTRAINT `fk_trace_node_execution` FOREIGN KEY (`id_node_execution`) REFERENCES `platform_observability_resource_node_execution` (`id_node_execution`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_conversation_message` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `conversation_id` int(11) NOT NULL,
  `message` text DEFAULT NULL,
  `role` varchar(50) NOT NULL,
  `metadata` mediumtext DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `idx_message_conversation` (`conversation_id`),
  KEY `idx_message_role` (`role`),
  KEY `idx_message_created` (`created_at`),
  CONSTRAINT `fk_message_conversation` FOREIGN KEY (`conversation_id`) REFERENCES `platform_bot_conversation` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_model` (
  `model_id` int(11) NOT NULL AUTO_INCREMENT,
  `client_id` int(11) NOT NULL,
  `provider_id` int(11) NOT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`model_id`),
  UNIQUE KEY `uk_client_provider` (`client_id`,`provider_id`),
  KEY `idx_model_client` (`client_id`),
  KEY `idx_model_provider` (`provider_id`),
  CONSTRAINT `fk_model_client` FOREIGN KEY (`client_id`) REFERENCES `platform_client` (`id`) ON DELETE CASCADE,
  CONSTRAINT `fk_model_provider` FOREIGN KEY (`provider_id`) REFERENCES `platform_provider` (`provider_id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_decision_tree_conversation` (
  `conversation_id` varchar(36) NOT NULL,
  `tree_id` int(11) NOT NULL,
  `client_id` int(11) NOT NULL,
  `start_time` timestamp NOT NULL DEFAULT current_timestamp(),
  `last_step_time` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`conversation_id`),
  KEY `idx_dt_conv_tree_client` (`tree_id`,`client_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_unicode_ci;

CREATE TABLE `platform_vision_extractor_field` (
  `field_id` int(11) NOT NULL AUTO_INCREMENT,
  `extractor_id` int(11) NOT NULL,
  `field_name` varchar(255) NOT NULL,
  `field_description` mediumtext DEFAULT NULL,
  `field_type` varchar(50) NOT NULL,
  `field_order` tinyint(3) DEFAULT 0,
  `is_required` tinyint(1) DEFAULT 0,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`field_id`),
  KEY `idx_field_extractor` (`extractor_id`),
  KEY `idx_field_name_extractor` (`field_name`,`extractor_id`),
  KEY `idx_field_order` (`extractor_id`,`field_order`),
  CONSTRAINT `fk_field_extractor` FOREIGN KEY (`extractor_id`) REFERENCES `platform_vision_extractor` (`extractor_id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_observability_resource_execution` (
  `execution_id` varchar(255) NOT NULL,
  `resource_type` varchar(255) NOT NULL,
  `resource_id` varchar(255) NOT NULL,
  `client_id` int(11) DEFAULT NULL,
  `status` varchar(50) NOT NULL,
  `start_time` timestamp NULL DEFAULT NULL,
  `end_time` timestamp NULL DEFAULT NULL,
  `duration_ms` int(11) DEFAULT NULL,
  `error_message` mediumtext DEFAULT NULL,
  `input_data` mediumtext DEFAULT NULL,
  `output_data` mediumtext DEFAULT NULL,
  `total_cost` decimal(10,8) DEFAULT NULL,
  PRIMARY KEY (`execution_id`),
  KEY `idx_execution_resource` (`resource_type`,`resource_id`),
  KEY `idx_execution_client` (`client_id`),
  KEY `idx_execution_status` (`status`),
  KEY `idx_execution_start_time` (`start_time`),
  KEY `idx_execution_client_status` (`client_id`,`status`),
  CONSTRAINT `fk_execution_client` FOREIGN KEY (`client_id`) REFERENCES `platform_client` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

SET FOREIGN_KEY_CHECKS=1;
