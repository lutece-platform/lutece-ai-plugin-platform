) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_dataset` (
  `dataset_id` int(11) NOT NULL AUTO_INCREMENT,
