  KEY `idx_bot_active` (`is_active`),
  CONSTRAINT `fk_bot_client` FOREIGN KEY (`client_id`) REFERENCES `platform_client` (`id`) ON DELETE CASCADE,
  CONSTRAINT `fk_bot_embed_provider` FOREIGN KEY (`embed_provider_id`) REFERENCES `platform_provider` (`provider_id`),
  CONSTRAINT `fk_bot_llm_provider` FOREIGN KEY (`llm_provider_id`) REFERENCES `platform_provider` (`provider_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `platform_dataset_document` (
  `document_id` int(11) NOT NULL AUTO_INCREMENT,
