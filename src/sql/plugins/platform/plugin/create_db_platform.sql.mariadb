  `chunk_overlap` int(11) DEFAULT 200 COMMENT 'Overlap between text chunks',
  `weight` decimal(4,2) DEFAULT 1.00 COMMENT 'Weight for ranking fusion (0.1 to 10.0)',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`document_id`),
  UNIQUE KEY `uk_document_file_key` (`document_file_key`),
